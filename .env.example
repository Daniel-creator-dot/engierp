# ---- API server (server/src) ----

# "production" makes the API use DATABASE_URL (see knexfile.ts).
NODE_ENV=development

# Postgres connection string (Supabase: Project Settings > Database > Connection string, pooler).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Signs login sessions. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# SMS gateway (Intek SMS by default). Leave SMS_API_KEY empty to disable SMS.
# Never commit a real key; set it on the host only.
SMS_API_KEY=""
# intek (default), hubtel, twilio or custom (URL template in SMS_API_URL).
SMS_PROVIDER=""
# Approved sender ID name on the provider account.
SMS_SENDER_ID=""
# Intek: https://www.inteksms.top/api/v1 (the default when empty).
SMS_API_URL=""
# Only for providers that need a secret (Hubtel, Twilio).
SMS_API_SECRET=""

# Port for the API (hosts like Render set this automatically).
PORT=5000

# ---- Web app (Vite, read at build time) ----

# Public URL of the API. "/api" is appended if missing.
VITE_API_URL="http://localhost:5000/api"
