# ---- API server (server/src) ----

# "production" makes the API use DATABASE_URL (see knexfile.ts).
NODE_ENV=development

# Postgres connection string (Supabase: Project Settings > Database > Connection string, pooler).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Signs login sessions. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# SMS gateway (SMS Notify GH by default). Leave empty to disable SMS.
SMS_API_KEY=""
# Optional overrides; normally configured in Settings > SMS Gateway.
SMS_API_SECRET=""
SMS_SENDER_ID=""
SMS_API_URL=""

# Port for the API (hosts like Render set this automatically).
PORT=5000

# ---- Web app (Vite, read at build time) ----

# Public URL of the API. "/api" is appended if missing.
VITE_API_URL="http://localhost:5000/api"
